{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@2.2.8/oh-my-opencode-slim.schema.json",
  "preset": "sdd-personal",
  "setDefaultAgent": true,
  "autoUpdate": false,
  "disabled_agents": [
    "council"
  ],
  "image_routing": "auto",
  "disabled_skills": [
    "worktrees"
  ],
  "disabled_mcps": [
    "websearch",
    "context7",
    "gh_grep"
  ],
  "multiplexer": {
    "type": "none"
