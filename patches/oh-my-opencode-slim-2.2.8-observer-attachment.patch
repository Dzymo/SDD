+function createObserverAttachmentTool(options) {
+  const observer_attachment = tool5({
+    description: "Create a child Observer session and send saved image files as structured attachments. Use this for visual analysis after image routing saves files under .opencode/images. Do not use task or read for this handoff.",
+    args: {
+      files: z7.array(z7.string().min(1)).min(1).max(4).describe("Full paths to image files saved under .opencode/images for this workspace"),
+      prompt: z7.string().min(1).max(4e3).describe("The visual question for Observer to answer")
+    },
+    async execute(args, toolContext) {
+      const parentID = toolContext?.sessionID;
+      if (!parentID)
+        throw new Error("observer_attachment requires sessionID");
+      const agent = typeof toolContext?.agent === "string" ? options.resolveAgentName?.(toolContext.agent) ?? toolContext.agent : void 0;
+      if (agent && agent !== "orchestrator")
+        throw new Error("observer_attachment can only be used by orchestrator");
+      const directory = toolContext?.directory;
+      const worktree = toolContext?.worktree;
+      if (!directory || !worktree)
+        throw new Error("observer_attachment requires workspace paths");
+      const imageRoot = path22.resolve(worktree, ".opencode", "images");
+      const comparableRoot = process.platform === "win32" ? imageRoot.toLowerCase() : imageRoot;
+      const mimeForPath = (filePath) => {
+        switch (path22.extname(filePath).toLowerCase()) {
+          case ".jpg":
+          case ".jpeg":
+            return "image/jpeg";
+          case ".png":
+            return "image/png";
+          case ".gif":
+            return "image/gif";
+          case ".webp":
+            return "image/webp";
+          default:
+            throw new Error(`observer_attachment does not support ${path22.extname(filePath) || "this file type"}`);
+        }
+      };
+      const parts = [{
+        type: "text",
+        text: `Analyze the attached image evidence and answer only the requested visual question.\n\n${args.prompt}`
+      }];
+      for (const requestedPath of args.files) {
+        const absolutePath = path22.resolve(directory, requestedPath);
+        const comparablePath = process.platform === "win32" ? absolutePath.toLowerCase() : absolutePath;
+        if (!comparablePath.startsWith(`${comparableRoot}${path22.sep}`))
+          throw new Error("observer_attachment only accepts files saved under .opencode/images");
+        const stat = fs9.statSync(absolutePath);
+        if (!stat.isFile())
+          throw new Error(`observer_attachment file is not a regular file: ${absolutePath}`);
+        if (stat.size > 10485760)
+          throw new Error(`observer_attachment file exceeds the 10 MiB limit: ${absolutePath}`);
+        const mime = mimeForPath(absolutePath);
+        const data = fs9.readFileSync(absolutePath);
+        parts.push({
+          type: "file",
+          mime,
+          filename: path22.basename(absolutePath),
+          url: `data:${mime};base64,${data.toString("base64")}`
+        });
+      }
+      const created = await options.client.session.create({
+        responseStyle: "data",
+        throwOnError: true,
+        query: { directory },
+        body: { parentID, title: "observer-image" }
+      });
+      const childID = created?.data?.id ?? created?.id;
+      if (!childID)
+        throw new Error("observer_attachment child session did not return an id");
+      const response = await options.client.session.prompt({
+        responseStyle: "data",
+        throwOnError: true,
+        path: { id: childID },
+        query: { directory },
+        body: { agent: "observer", parts }
+      });
+      const result = response?.data ?? response;
+      const text = Array.isArray(result?.parts) ? result.parts.filter((part) => part?.type === "text" && typeof part.text === "string").map((part) => part.text).join("").trim() : "";
+      if (!text)
+        throw new Error("observer_attachment child session returned no text");
+      return `state: completed\nprotocol: oh-my-opencode-slim.observer_attachment.v1\nobserver_session_id: ${childID}\n\n${text}`;
+    }
+  });
+  return { observer_attachment };
+}
