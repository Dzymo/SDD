+function createObserverAttachmentTool(options) {
+  // Creates a child session with parentID and prompts it synchronously so the
+  // visual result returns to the parent tool call.
+  // It accepts only PNG, JPEG, GIF, and WebP files below .opencode/images,
+  // reads at most 10 MiB each, and sends FilePart data URLs with agent: observer.
+  // Register the returned observer_attachment tool beside wait_for_user.
+}
